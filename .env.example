# ============================================================
# 荷源管理系统 环境变量模板
# 使用：复制本文件为 .env.dev（开发）或 .env.prod（生产），填写真实值
# 注意：本文件只有占位符，真实密钥请勿提交到 git
# ============================================================

# =========================
# 应用基础配置
# =========================
NODE_ENV=dev                      # dev / prod / test
APP_PORT=8000                     # 后端端口
SESSION_TYPE=jwt                  # jwt | redis-token

# =========================
# MySQL 数据库配置（TypeORM）
# =========================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=改成你的MySQL密码
MYSQL_DB=heyuan
TYPEORM_LOGGING=false

# =========================
# Redis 配置
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =========================
# JWT 认证配置
# =========================
JWT_SECRET_KEY=改成你的JWT密钥（至少32字符）
JWT_EXPIRES_IN=7200
JWT_ISSUER=heyuan-admin

# =========================
# OSS / 文件存储（aliyun | minio | local）
# =========================
OSS_TYPE=local
OSS_MINIO_ENDPOINT=http://localhost:9000
OSS_MINIO_ACCESS_KEY=minioadmin
OSS_MINIO_SECRET_KEY=minioadmin
OSS_MINIO_BUCKET=default
OSS_MINIO_CUSTOM_DOMAIN=
OSS_ALIYUN_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ALIYUN_ACCESS_KEY_ID=your-access-key-id
OSS_ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ALIYUN_BUCKET=default
OSS_LOCAL_STORAGE_PATH=./data/oss/

# =========================
# 微信小程序
# =========================
WX_MINIAPP_APP_ID=Your_AppId
WX_MINIAPP_APP_SECRET=Your_AppSecret

# =========================
# 智谱 RAG
# =========================
ZHIPU_API_KEY=你的智谱APIKey
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=512
RERANK_MODEL=rerank
CHAT_MODEL=glm-4-flash

# =========================
# Milvus
# =========================
MILVUS_ADDRESS=127.0.0.1:19530
MILVUS_COLLECTION=heyuan_knowledge

# =========================
# 源 markdown 本地存储
# =========================
RAG_STORAGE_ROOT=./data/rag/
